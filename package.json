{
  "name": "sleek-shop",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Sleek Shop: installable storefront, customer accounts and admin console, backed by Turso.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/start.ts",
    "dev:full": "concurrently -k -n API,WEB -c magenta,cyan \"npm run dev:api\" \"npm run dev\"",
    "predev": "tsx scripts/fetch-images.ts --soft",
    "prebuild": "tsx scripts/fetch-images.ts --soft",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "vite preview --host 0.0.0.0 --port 4173",
    "images": "tsx scripts/fetch-images.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts --",
    "db:reset": "tsx scripts/seed.ts -- --force",
    "admin:create": "tsx scripts/create-admin.ts --"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.1.1",
    "@fontsource/playfair-display": "^5.1.1",
    "@libsql/client": "^0.15.15",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.12",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.6"
    }
  },
  "engines": { "node": ">=20.0.0" }
}
